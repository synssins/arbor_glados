[Unit]
Description=Arbor Core Control Server
Documentation=https://github.com/chriskliewer/arbor
After=network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=synthesis
Group=synthesis

# Configuration via environment
Environment=ARBOR_CONFIG=/etc/arbor/arbor.yaml

# Working directory
WorkingDirectory=/opt/arbor

# Start the control server — bind localhost only (nginx handles external access)
ExecStart=/opt/arbor/.venv/bin/uvicorn arbor_core.main:app --host 127.0.0.1 --port 8000 --workers 1

# Graceful shutdown (SIGTERM -> uvicorn handles it)
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30

# Restart policy
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/arbor /var/log/arbor /etc/arbor
PrivateTmp=true

# Hardware access — serial ports, GPIO, SPI, I2C
SupplementaryGroups=dialout gpio spi i2c

# Logging goes to journald (structlog JSON output)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arbor-core

[Install]
WantedBy=multi-user.target
